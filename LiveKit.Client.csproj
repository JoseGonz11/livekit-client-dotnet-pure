<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Runtime\Plugins\ffi-windows-x86_64\livekit_ffi.dll" Link="runtimes\win-x64\native\livekit_ffi.dll" CopyToOutputDirectory="PreserveNewest" />

        <Content Include="Runtime\Plugins\ffi-windows-arm64\livekit_ffi.dll" Link="runtimes\win-arm64\native\livekit_ffi.dll" CopyToOutputDirectory="PreserveNewest" />

        <Content Include="Runtime\Plugins\ffi-linux-x86_64\liblivekit_ffi.so" Link="runtimes\linux-x64\native\liblivekit_ffi.so" CopyToOutputDirectory="PreserveNewest" />

        <Content Include="Runtime\Plugins\ffi-macos-x86_64\liblivekit_ffi.dylib" Link="runtimes\osx-x64\native\liblivekit_ffi.dylib" CopyToOutputDirectory="PreserveNewest" />

        <Content Include="Runtime\Plugins\ffi-macos-arm64\liblivekit_ffi.dylib" Link="runtimes\osx-arm64\native\liblivekit_ffi.dylib" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>AmperComm.Client.Avalonia</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    
</Project>